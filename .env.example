# =============================================================================
# Bank Nifty Trading App - environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` or hard-code secrets in source.
# =============================================================================

# --- runtime ---------------------------------------------------------------
# `paper` (default) = real broker prices, SIMULATED fills. Zero real orders.
# `live` = real orders, real money.
#
# Live trading needs ALL THREE of these to be true. LIVE_ARMED is the master
# interlock: while it is false, live is impossible no matter what the other two
# say (enforced in config, in the executor router, and again before every broker
# call). Do not hand-edit it to true - use:
#     python -m banknifty_trading_app.main arm-live      (needs confirmation)
#     python -m banknifty_trading_app.main disarm-live
#     python -m banknifty_trading_app.main live-status
MODE=paper
LIVE_TRADING=false
LIVE_ARMED=false
ACTIVE_STRATEGY=v1_baseline

# --- Angel One SmartAPI credentials ---------------------------------------
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# --- network / TLS ---------------------------------------------------------
# Verify HTTPS against the operating system certificate store. Needed when a
# corporate proxy re-signs TLS (Zscaler, Netskope, Fortinet...): its root CA is
# in the Windows/macOS store but not in certifi, and without this every HTTPS
# call fails with CERTIFICATE_VERIFY_FAILED. Verification stays ON.
USE_SYSTEM_TRUST_STORE=true

# smartapi-python sends a hardcoded X-ClientPublicIP header, which breaks an
# IP-whitelisted API key. Leave these blank to auto-detect. If auto-detection is
# blocked or your public IP changes between requests (multi-WAN / proxy egress),
# ask Angel One to remove the IP restriction instead - a moving egress IP cannot
# be whitelisted reliably.
CLIENT_PUBLIC_IP=
CLIENT_LOCAL_IP=

# --- paths (relative to the process working directory) ---------------------
STRATEGY_DIR=strategy_versions
DATA_DIR=data
LOG_DIR=logs
REPORT_DIR=reports
DB_PATH=data/banknifty.sqlite3
KILL_SWITCH_FILE=data/KILL_SWITCH

# --- execution defaults ----------------------------------------------------
# NRML carries overnight (required by the strategy). MIS must NOT be used.
PRODUCT_TYPE=NRML
ORDER_TYPE=MARKET
MARKET_PROTECT_BUFFER_POINTS=0.5
PAPER_SLIPPAGE_POINTS=0.5
TICK_SIZE=0.05
ORDER_STATUS_TIMEOUT_S=10
ORDER_STATUS_POLL_INTERVAL_S=0.25

# --- risk ------------------------------------------------------------------
MAX_LOTS=10
# Leave blank to disable a limit.
MAX_DAILY_LOSS=
MAX_TRADES_PER_DAY=

# --- market data feed ------------------------------------------------------
STALE_TICK_TIMEOUT_S=5
WS_RECONNECT_INITIAL_S=1
WS_RECONNECT_MAX_S=30
WS_MODE=1

# --- session (IST) ---------------------------------------------------------
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
EXPIRY_SQUAREOFF_TIME=15:15
TIMEZONE=Asia/Kolkata

# --- backtest --------------------------------------------------------------
BACKTEST_START=
BACKTEST_END=
BACKTEST_INTERVAL=ONE_MINUTE
BACKTEST_INTRABAR=conservative

# --- dashboard / web app ---------------------------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Full read-write web console
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Optional: if set, the web API requires an "X-Auth-Token" header (leave blank on localhost)
WEB_TOKEN=

# --- web console login -----------------------------------------------------
# Set APP_PASSWORD to require a login page before the console can be used.
# Leave blank to disable the login page (fine for trusted localhost use).
APP_USERNAME=admin
APP_PASSWORD=
# Accounts created via the /register page are stored here (hashed passwords).
AUTH_DB_PATH=data/users.sqlite3
# Invite code required for sign-ups once an account already exists.
# Leave blank to keep registration closed after the first account.
REGISTER_CODE=

# --- Angel One endpoints (verify against official docs before changing) ----
ANGEL_REST_URL=https://apiconnect.angelone.in
ANGEL_WS_URL=wss://smartapisocket.angelone.in/smart-stream
ANGEL_INSTRUMENT_MASTER_URL=https://margincalculator.angelbroking.com/OpenAPI_File/files/OpenAPIScripMaster.json
